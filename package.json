{
  "name": "vscode-pi-companion",
  "displayName": "PI Companion",
  "description": "Share VS Code context with pi coding agent",
  "repository": "https://github.com/ravshansbox/vscode-pi-companion",
  "version": "0.2.0",
  "publisher": "ravshansbox",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --import ./test/setup.mjs --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "PI Companion",
      "properties": {
        "piCompanion.port": {
          "type": "number",
          "default": 8765,
          "description": "Port for MCP server"
        }
      }
    },
    "commands": [
      {
        "command": "pi-companion.start",
        "title": "PI Companion: Start Server"
      },
      {
        "command": "pi-companion.stop",
        "title": "PI Companion: Stop Server"
      },
      {
        "command": "pi-companion.status",
        "title": "PI Companion: Show Status"
      }
    ]
  }
}
